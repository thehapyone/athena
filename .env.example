# Copy to .env and replace every placeholder before starting the Compose stack.
#
#   cp .env.example .env

# Required secrets
ATHENA_POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ATHENA_API_TOKEN=replace-with-a-random-api-token-of-at-least-16-characters
ATHENA_EMBEDDING_BASE_URL=https://api.openai.com/v1
ATHENA_EMBEDDING_API_KEY=replace-with-your-embedding-provider-key
ATHENA_EMBEDDING_MODEL=text-embedding-3-small
ATHENA_EMBEDDING_DIMENSION=1536

# Optional tuning
ATHENA_MAX_UPLOAD_BYTES=52428800
ATHENA_RETRIEVAL_MODE=hybrid
ATHENA_LOG_LEVEL=INFO
DOCLING_TIMEOUT_SECONDS=660

# The default Compose deployment starts Docling at http://docling:5001.
# Set this only when using a separately managed Docling service.
# DOCLING_BASE_URL=https://docling.example.com
